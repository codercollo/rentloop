# ─────────────────────────────────────────────────────────────────────────────
# RentLoop — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────

PORT=8080

# development | production
# In development:
#   - IP validation on M-Pesa callbacks is skipped
#   - Twilio signature validation is skipped
#   - PDF receipts are saved locally (tmp/receipts/) and served at /dev/receipts/*
#   - DO Spaces upload is bypassed (fakeUploader used instead)
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://rentloop:rentloop@localhost:5432/rentloop?sslmode=disable

# ── Admin ─────────────────────────────────────────────────────────────────────

# One-time admin setup secret — access /admin/setup?secret=VALUE to register
# the first admin account. Leave blank to disable the setup endpoint.
ADMIN_SETUP_SECRET=change-me-before-production

# JWT signing secret — must be at least 32 characters
JWT_SECRET=replace-with-64-char-random-hex-string-here-00000000000000000000

# Admin activation link secret (emailed on registration)
ACTIVATION_SECRET=replace-with-another-64-char-random-hex-string-000000000000000

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────

# sandbox | production
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Your paybill shortcode (same value used for MPESA_SHORTCODE)
MPESA_PAYBILL=174379
MPESA_SHORTCODE=174379

# STK Push passkey from Daraja portal
MPESA_PASSKEY=your_mpesa_passkey

# Public URL Safaricom will POST callbacks to (use ngrok in dev)
# C2B: register this in Daraja portal under C2B callback URL
# STK: passed as CallBackURL in STK Push requests
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/mpesa/stk/callback

# ── Twilio ────────────────────────────────────────────────────────────────────

TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token

# WhatsApp sender — Twilio sandbox: whatsapp:+14155238886
# Production: your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS sender — Twilio sandbox number or your approved alphanumeric sender ID
TWILIO_SMS_FROM=+13185588546

# Full public URLs Twilio posts webhooks to — required in production,
# optional in development (signature validation is skipped in dev mode).
WHATSAPP_WEBHOOK_URL=https://api.rentloop.co.ke/bot/whatsapp
SMS_WEBHOOK_URL=https://api.rentloop.co.ke/bot/sms

# ── Africa's Talking (optional — legacy SMS fallback) ─────────────────────────

AT_API_KEY=your_at_api_key
AT_USERNAME=sandbox
AT_WHATSAPP_NUMBER=+254700000000
AT_SMS_SENDER_ID=RentLoop

# ── DigitalOcean Spaces (S3-compatible object storage for PDF receipts) ───────
# In APP_ENV=development these are not used — PDFs are saved to tmp/receipts/
# Generate keys at: cloud.digitalocean.com → API → Spaces Keys

DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# Optional: CDN URL prefix (e.g. https://cdn.rentloop.co.ke)
# If blank, receipts are served directly from Spaces.
# DO_SPACES_CDN_BASE=

# ── Billing ───────────────────────────────────────────────────────────────────

# Days after month start before subscription reminder is sent
BILLING_GRACE_DAYS=5

# KES per unit per month
SUBSCRIPTION_PRICE_PER_UNIT=50

# Units below this threshold are free (inclusive)
FREE_TIER_UNIT_LIMIT=3

# ── Internal services ─────────────────────────────────────────────────────────

# Base URL for internal HTTP calls (e.g. billing STK trigger)
INTERNAL_BASE_URL=http://localhost:8080

# Phone number to receive new-landlord signup alerts via WhatsApp
OWNER_PHONE=+254700000000
