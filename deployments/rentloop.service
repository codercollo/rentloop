[Unit]
Description=RentLoop API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=rentloop
Group=rentloop

# Server binary only — migration is run by deploy.yml before this restarts
ExecStart=/opt/rentloop/bin/rentloop-server
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

EnvironmentFile=/etc/rentloop.env

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/rentloop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rentloop

[Install]
WantedBy=multi-user.target